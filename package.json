{
  "name": "gabarito",
  "version": "0.3.0",
  "private": true,
  "description": "Gabarito — estudo de massa e viabilidade imobiliária (protótipo local)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/bundle.mjs && node tools/bundle.mjs --out dist",
    "bundle": "node tools/bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "screens": "node tools/screens.cjs",
    "check": "node tools/bundle.mjs && vitest run && node tools/screens.cjs all"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "three": "0.128.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
