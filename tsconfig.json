{
  // Fase de protótipo: os arquivos de src/ são scripts globais concatenados (não módulos).
  // O TypeScript entende isso: arquivos sem import/export compartilham o escopo global.
  // checkJs fica desligado no geral; cada arquivo pode optar com "// @ts-check" no topo.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.js", "types/**/*.d.ts"]
}
